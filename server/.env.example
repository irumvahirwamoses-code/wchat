# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- Database ----------------------------------------------------------------
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/wchat
# MongoDB Atlas free M0 (replace user/password/cluster):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/wchat?retryWrites=true&w=majority

# --- Auth --------------------------------------------------------------------
# Use a long random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=wchat_dev_secret_change_in_production

# --- Client origin(s) for CORS + Socket.IO -----------------------------------
# Local development:
CLIENT_URL=http://localhost:5173
# Production: comma-separated list of every origin that may call the API.
# CLIENT_URL=https://wchat.vercel.app,https://www.wchat.app

# --- Wchat branding -----------------------------------------------------------
APP_NAME=Wchat

# --- Uploads (optional but recommended on free hosts) ------------------------
# Render/Koyeb/Fly.io filesystems are ephemeral: local uploads disappear on the
# next deploy. Add Cloudinary credentials to keep media permanently. Free tier:
# https://cloudinary.com/console  (Dashboard → Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wchat

# --- Email verification via Brevo (https://app.brevo.com/settings/keys/api) ---
# Leave BREVO_API_KEY empty in development: the code is then printed to the
# server console so you can still complete registration.
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@wchat.app
MAIL_FROM_NAME=Wchat

# --- SMS verification (any HTTP gateway: Africa's Talking, Pindo, Twilio...) --
# POST { to, message, sender } as JSON. Leave empty in development to log codes.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Wchat

# --- Verification codes ------------------------------------------------------
VERIFY_CODE_TTL_MINUTES=10
