# ---------------------------------------------------------------
# Wchat Server — environment variables (copy to .env and fill in)
# ---------------------------------------------------------------
# Never commit real secrets. This file is safe to commit.

# Port (Render/Railway/Koyeb inject this automatically; leave for local)
PORT=5000

# Node environment
NODE_ENV=production

# MongoDB Atlas connection string (M0 free tier)
# Example: mongodb+srv://wchat:<password>@cluster0.xxxxx.mongodb.net/wchat?retryWrites=true&w=majority
MONGO_URI=

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set once and never change (existing tokens would become invalid).
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Comma-separated allowed client origins (no trailing slashes).
# Example: https://wchat.vercel.app,https://wchat.is-a.dev
CLIENT_URL=https://wchat.vercel.app

# App name used in emails / UI
APP_NAME=Wchat

# ---------------------------------------------------------------
# Cloudinary (free tier) — permanent media storage.
# Without these, uploads go to ephemeral local disk and disappear on redeploy.
# ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wchat

# ---------------------------------------------------------------
# Brevo (email verification) — free tier. Empty = dev mode (codes logged).
# ---------------------------------------------------------------
BREVO_API_KEY=
MAIL_FROM_EMAIL=no-reply@wchat.app
MAIL_FROM_NAME=Wchat

# ---------------------------------------------------------------
# SMS gateway (optional) — empty = dev mode (codes logged).
# ---------------------------------------------------------------
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Wchat

# Verification code TTL in minutes
VERIFY_CODE_TTL_MINUTES=10
