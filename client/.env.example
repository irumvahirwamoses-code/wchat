# --- Client ------------------------------------------------------------------
# URL of the Wchat API (no trailing slash).
#
# Leave EMPTY for local development or a single-host deployment where Express
# serves both the built client and the API (requests then use `/api`).
#
# Set it when the client is hosted separately from the API, e.g. on Vercel
# while the API runs on Render:
# VITE_API_URL=https://wchat-api.onrender.com
VITE_API_URL=
